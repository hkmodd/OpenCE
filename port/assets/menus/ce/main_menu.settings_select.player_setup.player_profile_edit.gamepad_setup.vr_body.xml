	<strings name="main_menu/settings_select/player_setup/player_profile_edit/gamepad_setup/vr_body/help_strings">
		<string text=""/>
		<string text="CHIEF: the Master Chief's eyes, 1.89 m, as high\nas the head stands. PLAYER: the player's own."/>
		<string text="FREE: each arm its own, the other hand free\nuntil it holds the weapon. ON WEAPON: the game's."/>
		<string text="The barrel from where the hand points, degrees\nup: raise it if shots go lower than it points."/>
		<string text="A punch strikes, a grip at the visor is the\nflashlight, over the shoulder it holsters."/>
		<string text="PHYSICAL: hold the weapon by the grip, let go\nto put it back. GAME: always in the hand."/>
		<string text="HOLD: the grip held holds the weapon. TOGGLE:\na press holds it, another lets go."/>
		<string text="THROWN: hold the trigger, throw with the arm.\nBUTTON: the trigger throws at once."/>
		<string text="The view's edges darken while it moves or\nturns by itself, not with the head."/>
		<string text="Cinematics around the head, a blink at each cut,\nor on a screen ahead."/>
	</strings>
