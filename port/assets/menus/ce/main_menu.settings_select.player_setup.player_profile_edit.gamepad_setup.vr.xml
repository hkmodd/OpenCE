	<strings name="main_menu/settings_select/player_setup/player_profile_edit/gamepad_setup/vr/help_strings">
		<string text=""/>
		<string text="Play in an OpenXR headset (Oculus, SteamVR,\nMonado). From the next start."/>
		<string text="On foot: the controller, the weapon held in it,\nor the head."/>
		<string text="The hand the weapon starts in, the other stick\nmoves. Pass it hand to hand: the buttons stay."/>
		<string text="The aiming stick turns by snaps of so many\ndegrees, or smoothly."/>
		<string text="Step in the room and the player follows; off,\nthe head leans 35 cm at most."/>
		<string text="Ride in the seat, the view level with the\nvehicle, or behind it as the game does."/>
		<string text="What aims guns and flies a Banshee in a seat:\nthe controller, its stick or the head."/>
		<string text="A Warthog's or Ghost's driver steers with the\nother stick, or toward the aim as the game does."/>
		<string text="Games you host are VR servers: the browser shows\nVR, and headsets play there by the hands' rules."/>
		<string text="The height, the arms, the aim's angle, gestures,\ngrenades, comfort and cinematics."/>
	</strings>
